		Position = UDim2.fromOffset(20, 52),
		Size = UDim2.new(1, -40, 0, 40),
		Text = "Maget Hub will close and all features will be turned off.",
		TextColor3 = THEME.sub,
		TextSize = 13,
		TextWrapped = true,
	})

	local holders = {}
	local function choice(text, base, hover, cx, delay, onClick)
		local h = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(cx, 124),
			Size = UDim2.fromOffset(110, 38),
			BackgroundTransparency = 1,
			Rotation = -180,
		}, dlg)
		local hs = new("UIScale", { Scale = 0 }, h)
		local b = new("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = base,
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextColor3 = Color3.new(1, 1, 1),
		}, h)
		corner(b, 8)
		styleButton(b, base, hover)
		b.MouseButton1Click:Connect(onClick)
		task.delay(0.25 + delay, function()
			if h.Parent then
				-- Enlarge + Rotate "Face in Bounce"
				tw(hs, 0.6, { Scale = 1 }, Enum.EasingStyle.Back)
				tw(h, 0.8, { Rotation = 0 }, Enum.EasingStyle.Bounce)
			end
		end)
		holders[#holders + 1] = { h = h, s = hs }
	end

	local function dismiss(after)
		for _, o in ipairs(holders) do
			tw(o.s, 0.2, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			tw(o.h, 0.25, { Rotation = 180 })
		end
		tw(ds, 0.3, { Scale = 0.7 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tw(dlg, 0.25, { GroupTransparency = 1 })
		tw(overlay, 0.3, { BackgroundTransparency = 1 })
		task.delay(0.35, function()
			overlay:Destroy()
			confirmOpen = false
			if after then
				after()
			end
		end)
	end

	choice("Yes", THEME.red, THEME.redHover, 85, 0, function()
		dismiss(function()
			closeScript()
		end)
	end)
	choice("No", THEME.off, Color3.fromRGB(85, 85, 108), 215, 0.1, function()
		dismiss()
	end)
end

