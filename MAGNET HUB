local registry = {}
local catColor = {}
for _, c in ipairs(CATS) do
	registry[c.id] = {}
	catColor[c.id] = c.color
end
local prompts = {}
local marked = {}
local origHold = setmetatable({}, { __mode = "k" })
local entries = {}
local espOn = {}
for _, c in ipairs(CATS) do
	entries[c.id] = {}
end

local function isPlayerChar(inst)
	local cur = inst
	while cur and cur ~= workspace do
		if Players:GetPlayerFromCharacter(cur) then
			return true
		end
		cur = cur.Parent
	end
	return false
end

local function classify(inst)
	if inst:IsA("ProximityPrompt") then
		if origHold[inst] == nil then
			origHold[inst] = inst.HoldDuration
		end
		inst.HoldDuration = 0
		prompts[inst] = true
		return
	end
	local isModel, isPart = inst:IsA("Model"), inst:IsA("BasePart")
	if not (isModel or isPart) then
		return
	end
	local n = string.lower(inst.Name)
	for _, c in ipairs(CATS) do
		if (isModel or not c.modelOnly) and containsAny(n, c.kw) and not isPlayerChar(inst) then
			registry[c.id][inst] = true
		end
	end
end

local function getAdornee(inst)
	if inst:IsA("BasePart") then
		return inst
	end
	if inst:IsA("Model") then
		return inst.PrimaryPart or inst:FindFirstChildWhichIsA("BasePart")
	end
end

local function objPos(inst)
	if inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	return inst.Position
end

