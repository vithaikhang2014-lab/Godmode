-- ESP
------------------------------------------------------------------
local function removeEntry(id, inst)
	local e = entries[id][inst]
	if e then
		e.box:Destroy()
		e.bb:Destroy()
		entries[id][inst] = nil
	end
end

local function hasQualifiedAncestor(id, inst)
	local p = inst.Parent
	while p and p ~= workspace do
		if registry[id][p] and getAdornee(p) then
			return true
		end
		p = p.Parent
	end
	return false
end

local function createEntry(id, inst, part)
	local color = catColor[id]
	local box = new("SelectionBox", {
		Adornee = inst,
		Color3 = color,
		SurfaceColor3 = color,
		SurfaceTransparency = 0.8,
		LineThickness = 0.04,
	}, espFolder)
	local bb = new("BillboardGui", {
		Adornee = part,
		AlwaysOnTop = true,
		Size = UDim2.fromOffset(160, 22),
		StudsOffset = Vector3.new(0, 3, 0),
		LightInfluence = 0,
		ResetOnSpawn = false,
	}, espFolder)
	local lbl = label(bb, {
		Size = UDim2.fromScale(1, 1),
		Text = inst.Name,
		TextColor3 = color,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextStrokeTransparency = 0.4,
	})
	entries[id][inst] = { box = box, bb = bb, lbl = lbl, part = part }
end

local function refreshESP()
	for id, on in pairs(espOn) do
		if on then
			local ent = entries[id]
			for inst in pairs(registry[id]) do
				local e = ent[inst]
				if e then
					if not inst:IsDescendantOf(workspace) or not e.part.Parent then
						removeEntry(id, inst)
					end
				else
					local part = getAdornee(inst)
					if part and inst:IsDescendantOf(workspace) and not hasQualifiedAncestor(id, inst) then
						createEntry(id, inst, part)
					end
				end
			end
		end
	end
end

local function clearESP(id)
	for inst in pairs(entries[id]) do
		removeEntry(id, inst)
	end
end

local function setESP(id, on, silent)
	espOn[id] = on
	if on then
		refreshESP()
	else
		clearESP(id)
	end
	if not silent then
		announce(("ESP %s is %s!"):format(id, on and "active" or "off"), on and "on" or "off")
	end
end

local acc1, acc2 = 0, 0
bind(RunService.Heartbeat, function(dt)
	acc1 += dt
	acc2 += dt
	if acc2 >= 0.2 then
		acc2 = 0
		local hrp = getHRP()
		if hrp then
			for _, ent in pairs(entries) do
				for inst, e in pairs(ent) do
					if e.part.Parent then
						local d = (e.part.Position - hrp.Position).Magnitude
						e.lbl.Text = inst.Name .. " [" .. math.floor(d) .. " st]"
					end
				end
			end
		end
	end
	if acc1 >= 1.5 then
		acc1 = 0
		refreshESP()
		for p in pairs(prompts) do
			if p.Parent and p.HoldDuration ~= 0 then
				p.HoldDuration = 0
			end
		end
	end
end)

bind(workspace.DescendantAdded, classify)
bind(workspace.DescendantRemoving, function(inst)
	for _, c in ipairs(CATS) do
		registry[c.id][inst] = nil
		removeEntry(c.id, inst)
	end
	prompts[inst] = nil
	marked[inst] = nil
end)

local function scan()
	local desc = workspace:GetDescendants()
	for i, inst in ipairs(desc) do
		if closed then
			return
		end
		classify(inst)
		if i % 1500 == 0 then
			task.wait()
		end
	end
end

------------------------------------------------------------------
-- TELEPORT / RECYCLER
------------------------------------------------------------------
local function tpTo(pos)
	local hrp = getHRP()
	if not hrp then
		return false
	end
	local rot = hrp.CFrame - hrp.CFrame.Position
	hrp.CFrame = CFrame.new(pos) * rot
	hrp.AssemblyLinearVelocity = Vector3.zero
	return true
end

local function recyclerPoint(m)
	local cf, size = m:GetBoundingBox()
	return cf.Position + Vector3.new(0, size.Y / 2 + 3, 0)
end

-- nearest = true -> gan nhat, false -> xa nhat
local function pickRecycler(nearest)
	local hrp = getHRP()
	if not hrp then
		return nil
	end
	local named, all = {}, {}
	for m in pairs(registry.Recycler) do
		if m.Parent and m:IsDescendantOf(workspace) then
			all[#all + 1] = m
			if string.find(string.lower(m.Name), "recycler", 1, true) then
				named[#named + 1] = m
			end
		end
	end
	local list = #named > 0 and named or all
	local best, bestD
	for _, m in ipairs(list) do
		local d = (m:GetPivot().Position - hrp.Position).Magnitude
		if not bestD or (nearest and d < bestD) or (not nearest and d > bestD) then
			best, bestD = m, d
		end
	end
	return best
end

local function teleportToRecycler()
	if not unlocked or closed then
		return
	end
	local m = pickRecycler(true)
	if not m then
		announce("Scrap Recycler not found!", "off")
		return
	end
	if tpTo(recyclerPoint(m)) then
		announce("Teleport to Scrap Recycle Complete!", "on")
	end
end

bind(UIS.InputBegan, function(input, gp)
	if gp then
		return
	end
	if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftControl then
		teleportToRecycler()
	end
end)

------------------------------------------------------------------
-- AUTO LOOT
------------------------------------------------------------------
local loot = { running = false, delay = 100, token = 0 }
local setLootButton = function() end

local function isLootPrompt(p)
	local names, cur, i = {}, p.Parent, 0
	while cur and cur ~= workspace and i < 3 do
		names[#names + 1] = string.lower(cur.Name)
		cur = cur.Parent
		i += 1
	end
	local s = table.concat(names, " ")
	return containsAny(s, CONFIG.LootKeywords) and not containsAny(s, CONFIG.LootExclude)
end

local function promptPos(p)
	local par = p.Parent
	if par and par:IsA("BasePart") then
		return par.Position
	elseif par and par:IsA("Attachment") then
		return par.WorldPosition
	end
	local part = p:FindFirstAncestorWhichIsA("BasePart")
	if part then
		return part.Position
	end
	local model = p:FindFirstAncestorWhichIsA("Model")
	return model and model:GetPivot().Position
end

local function triggerPrompt(p)
	p.HoldDuration = 0
	p.RequiresLineOfSight = false
	p.MaxActivationDistance = math.max(p.MaxActivationDistance, 12)
	if typeof(fireproximityprompt) == "function" then
		pcall(fireproximityprompt, p)
	else
		pcall(function()
			p:InputHoldBegin()
			task.wait()
			p:InputHoldEnd()
		end)
	end
end

local function stopLoot(silent)
	if not loot.running then
		return
	end
	loot.running = false
	loot.token += 1
	table.clear(marked)
	setLootButton(false)
	if not silent then
		announce("Auto Loot is stopped!", "off")
	end
end

local function startLoot()
	if loot.running or closed then
		return
	end
	loot.running = true
	loot.token += 1
	local my = loot.token
	setLootButton(true)
	announce("Auto Loot is active!", "on")
	task.spawn(function()
		local finished = false
		while loot.running and loot.token == my and not closed do
			local targets = {}
			for p in pairs(prompts) do
				if p.Parent and p.Enabled and not marked[p] and p:IsDescendantOf(workspace) and isLootPrompt(p) then
					targets[#targets + 1] = p
				end
			end
			if #targets == 0 then
				finished = true
				break
			end
			local p = targets[math.random(#targets)]
			marked[p] = true
			local pos = promptPos(p)
			if pos and getHRP() then
				tpTo(pos + Vector3.new(0, CONFIG.LootHeight, 0))
				task.wait(0.05)
				triggerPrompt(p)
			end
			task.wait(math.max(loot.delay / 1000, 0.03))
		end
		if loot.token ~= my then
			return
		end
		table.clear(marked)
		loot.running = false
		setLootButton(false)
		if finished and not closed then
			announce("Auto Loot is done!", "on")
		end
	end)
end

------------------------------------------------------------------
-- SHIELD
------------------------------------------------------------------
local shield = { on = false, last = 0, conn = nil, part = nil, lastWarn = 0 }

local function wallHit(origin, dir, len)
	local ignore = { LocalPlayer.Character, shield.part, workspace.CurrentCamera }
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	for _ = 1, 6 do
		local r = workspace:Raycast(origin, dir * len, params)
		if not r then
			return false
		end
		local inst = r.Instance
		if inst.CanCollide and not (inst.Parent and inst.Parent:FindFirstChildOfClass("Humanoid")) then
			return true
		end
		table.insert(ignore, inst)
		params.FilterDescendantsInstances = ignore
	end
	return false
end

local function shieldStep()
	local hrp = getHRP()
	if not hrp or not shield.part then
		return
	end
	shield.part.CFrame = hrp.CFrame
	if os.clock() - shield.last < 0.3 then
		return
	end
	local best, bestD, bestPos
	for m in pairs(registry.Monster) do
		if m.Parent and m:IsDescendantOf(workspace) then
			local p = objPos(m)
			local d = (hrp.Position - p).Magnitude
			if d <= CONFIG.ShieldRadius and (not bestD or d < bestD) then
				best, bestD, bestPos = m, d, p
			end
		end
	end
	if not best then
		return
	end
	local flat = Vector3.new(hrp.Position.X - bestPos.X, 0, hrp.Position.Z - bestPos.Z)
	if flat.Magnitude < 0.05 then
		flat = Vector3.new(-hrp.CFrame.LookVector.X, 0, -hrp.CFrame.LookVector.Z)
	end
	local dir = flat.Unit
	local dist = math.random() * (CONFIG.PushMax - CONFIG.PushMin) + CONFIG.PushMin
	shield.last = os.clock()
	if wallHit(hrp.Position, dir, dist + 2) then
		-- bi dan vao tuong -> chay den Scrap Recycler xa nhat
		local m = pickRecycler(false)
		if m then
			tpTo(recyclerPoint(m))
			shield.last = os.clock() + 0.7
			if os.clock() - shield.lastWarn > 3 then
				shield.lastWarn = os.clock()
				announce("Shield: cornered! Teleported to Scrap Recycler!", "info")
			end
		end
	else
		tpTo(hrp.Position + dir * dist)
	end
end

local function setShield(v, silent)
	if v == shield.on then
		return
	end
	shield.on = v
	if v then
		shield.part = new("Part", {
			Name = "MagetShield",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * CONFIG.ShieldRadius * 2,
			Material = Enum.Material.ForceField,
			Color = Color3.fromRGB(110, 190, 255),
			Transparency = 0.75,
			Anchored = true,
			CanCollide = false,
			CanQuery = false,
			CanTouch = false,
			CastShadow = false,
		}, workspace.CurrentCamera)
		shield.conn = RunService.Heartbeat:Connect(shieldStep)
	else
		if shield.conn then
			shield.conn:Disconnect()
			shield.conn = nil
		end
		if shield.part then
			shield.part:Destroy()
			shield.part = nil
		end
	end
	if not silent then
		announce(v and "Shield is active!" or "Shield is off!", v and "on" or "off")
	end
end

