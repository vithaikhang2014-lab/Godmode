-- ANNOUNCE
------------------------------------------------------------------
local annToken, annCurrent = 0, nil
local function announce(text, kind)
	if closed and text ~= "Script is closed!" then
		return
	end
	annToken += 1
	local my = annToken
	if annCurrent then
		annCurrent:Destroy()
		annCurrent = nil
	end
	local col = kind == "off" and THEME.red or (kind == "info" and THEME.accent or THEME.green)
	local box = new("CanvasGroup", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -50),
		Size = UDim2.fromOffset(340, 42),
		BackgroundColor3 = THEME.bg,
		GroupTransparency = 1,
	}, topLayer)
	corner(box, 10)
	stroke(box, col, 1.5, 0.3)
	local bar = new("Frame", { Size = UDim2.new(0, 5, 1, 0), BackgroundColor3 = col, BorderSizePixel = 0 }, box)
	label(box, {
		Size = UDim2.new(1, -24, 1, 0),
		Position = UDim2.fromOffset(18, 0),
		Text = text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	})
	annCurrent = box
	tw(box, 0.5, { Position = UDim2.new(0.5, 0, 0, 18) }, Enum.EasingStyle.Back)
	tw(box, 0.3, { GroupTransparency = 0 })
	task.delay(2.4, function()
		if my ~= annToken then
			return
		end
		tw(box, 0.4, { Position = UDim2.new(0.5, 0, 0, -50) }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		tw(box, 0.4, { GroupTransparency = 1 })
		task.wait(0.45)
		if my == annToken then
			box:Destroy()
			annCurrent = nil
		end
	end)
end

