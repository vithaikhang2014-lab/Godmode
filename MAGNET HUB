	tw(sc, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
	tw(card, 0.4, { GroupTransparency = 0 })

	label(card, { Position = UDim2.fromOffset(0, 14), Size = UDim2.new(1, 0, 0, 30), Text = "Maget Hub", Font = Enum.Font.GothamBold, TextSize = 24 })
	label(card, { Position = UDim2.fromOffset(0, 46), Size = UDim2.new(1, 0, 0, 18), Text = "Enter your key to continue", TextColor3 = THEME.sub, TextSize = 13 })

	local box = new("TextBox", {
		Position = UDim2.fromOffset(20, 80),
		Size = UDim2.new(1, -40, 0, 38),
		BackgroundColor3 = THEME.row,
		PlaceholderText = "Key...",
		PlaceholderColor3 = THEME.sub,
		Text = "",
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamMedium,
		TextSize = 15,
		TextColor3 = THEME.text,
	}, card)
	corner(box, 8)
	local bs = stroke(box, THEME.off, 1, 0)
	box.Focused:Connect(function()
		tw(bs, 0.2, { Color = THEME.accent })
	end)
	box.FocusLost:Connect(function()
		tw(bs, 0.2, { Color = THEME.off })
	end)

	local verify = new("TextButton", {
		Position = UDim2.fromOffset(20, 130),
		Size = UDim2.new(1, -40, 0, 38),
		BackgroundColor3 = THEME.accent,
		Text = "Verify",
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = Color3.new(1, 1, 1),
	}, card)
	corner(verify, 8)
	styleButton(verify, THEME.accent, THEME.accentHover)

	local msg = label(card, { Position = UDim2.fromOffset(0, 180), Size = UDim2.new(1, 0, 0, 20), Text = "", TextSize = 13 })

	local xb = new("TextButton", {
		Position = UDim2.new(1, -32, 0, 8),
		Size = UDim2.fromOffset(24, 22),
		BackgroundColor3 = THEME.red,
		Text = "X",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Color3.new(1, 1, 1),
	}, card)
	corner(xb, 6)
	styleButton(xb, THEME.red, THEME.redHover)
	xb.MouseButton1Click:Connect(function()
		tw(sc, 0.3, { Scale = 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tw(card, 0.3, { GroupTransparency = 1 })
		task.wait(0.35)
		closeScript(true)
	end)

	local busy = false
	local function submit()
		if busy then
			return
		end
		local txt = box.Text:match("^%s*(.-)%s*$")
		if txt == CONFIG.Key then
			busy = true
			msg.Text = "Access granted!"
			msg.TextColor3 = THEME.green
			tw(st, 0.3, { Color = THEME.green })
			task.wait(0.5)
			tw(sc, 0.4, { Scale = 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
			tw(card, 0.35, { GroupTransparency = 1 })
			task.wait(0.45)
			card:Destroy()
			unlocked = true
			task.spawn(scan)
			buildMain()
			announce("Hello, " .. LocalPlayer.Name, "info")
		else
			msg.Text = "Invalid key!"
			msg.TextColor3 = THEME.red
			tw(st, 0.15, { Color = THEME.red })
			task.delay(0.6, function()
				if st.Parent and not busy then
					tw(st, 0.4, { Color = THEME.accent })
				end
			end)
			local base = box.Position
			task.spawn(function()
				for _, o in ipairs({ -8, 8, -6, 6, -3, 3, 0 }) do
					tw(box, 0.04, { Position = base + UDim2.fromOffset(o, 0) }, Enum.EasingStyle.Sine)
					task.wait(0.045)
				end
			end)
		end
	end
	verify.MouseButton1Click:Connect(submit)
	box.FocusLost:Connect(function(enter)
		if enter then
			submit()
		end
	end)
end

showKeyGate()
