-- CLOSE SCRIPT
------------------------------------------------------------------
local function closeScript(instant)
	if closed then
		return
	end
	closed = true
	stopLoot(true)
	setShield(false, true)
	for _, c in ipairs(CATS) do
		if c.esp then
			espOn[c.id] = false
			clearESP(c.id)
		end
	end
	for p, h in pairs(origHold) do
		if p.Parent then
			p.HoldDuration = h
		end
	end
	for _, c in ipairs(conns) do
		c:Disconnect()
	end
	table.clear(conns)
	_G.MagetHubClose = nil
	if instant then
		espFolder:Destroy()
		gui:Destroy()
		return
	end
	closed = false
	announce("Script is closed!", "off")
	closed = true
	for _, w in ipairs(windows) do
		w.close()
	end
	task.wait(1.8)
	espFolder:Destroy()
	gui:Destroy()
end
_G.MagetHubClose = function()
	closeScript(true)
end

