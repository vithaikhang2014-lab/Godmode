local windows = {}
local zCounter = 1
local askClose

local function makeWindow(title, pos, w, h)
	local root = new("CanvasGroup", {
		Name = title,
		Position = pos,
		Size = UDim2.fromOffset(w, h),
		BackgroundColor3 = THEME.bg,
		GroupTransparency = 1,
		Active = true,
		Visible = false,
	}, winLayer)
	corner(root, 12)
	stroke(root, THEME.accent, 1.2, 0.5)
	local scale = new("UIScale", { Scale = 0.8 }, root)

	local top = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = THEME.top, BorderSizePixel = 0 }, root)
	label(top, {
		Size = UDim2.new(1, -80, 1, 0),
		Position = UDim2.fromOffset(12, 0),
		Text = title,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
	})
	local function topBtn(text, x, base, hover)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(24, 22),
			Position = UDim2.new(1, x, 0.5, -11),
			BackgroundColor3 = base,
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = THEME.text,
		}, top)
		corner(b, 6)
		styleButton(b, base, hover)
		return b
	end
	local cbtn = topBtn("▼", -58, THEME.off, Color3.fromRGB(85, 85, 108))
	local xbtn = topBtn("X", -30, THEME.red, THEME.redHover)

	local content = new("Frame", {
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 1, -34),
		BackgroundTransparency = 1,
	}, root)

	local collapsed = false
	cbtn.MouseButton1Click:Connect(function()
		collapsed = not collapsed
		cbtn.Text = collapsed and "▲" or "▼"
		tw(root, 0.4, { Size = UDim2.fromOffset(w, collapsed and 34 or h) }, Enum.EasingStyle.Quint)
	end)
	xbtn.MouseButton1Click:Connect(function()
		askClose()
	end)

	-- keo tha
	local dragging, startMouse, startPos
	top.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startMouse = input.Position
			startPos = root.Position
			zCounter += 1
			root.ZIndex = zCounter
		end
	end)
	bind(UIS.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startMouse
			tw(root, 0.07, {
				Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y),
			}, Enum.EasingStyle.Quad)
		end
	end)
	bind(UIS.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	local win = { root = root, content = content }
	function win.open(delay)
		task.delay(delay or 0, function()
			if closed then
				return
			end
			root.Visible = true
			tw(scale, 0.55, { Scale = 1 }, Enum.EasingStyle.Back)
			tw(root, 0.4, { GroupTransparency = 0 })
		end)
	end
	function win.close()
		tw(scale, 0.35, { Scale = 0.8 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tw(root, 0.35, { GroupTransparency = 1 })
	end
	windows[#windows + 1] = win
	return win
end

local function makeToggle(parent, text, dotColor, cb, order)
	local row = new("Frame", { Size = UDim2.new(1, -10, 0, 36), BackgroundColor3 = THEME.row, LayoutOrder = order or 0 }, parent)
	corner(row, 8)
	local x = 12
	if dotColor then
		local dot = new("Frame", { Size = UDim2.fromOffset(9, 9), Position = UDim2.new(0, 10, 0.5, -4.5), BackgroundColor3 = dotColor }, row)
		corner(dot, 5)
		x = 28
	end
	label(row, { Size = UDim2.new(1, -90, 1, 0), Position = UDim2.fromOffset(x, 0), Text = text, TextXAlignment = Enum.TextXAlignment.Left })
	local sw = new("Frame", { Size = UDim2.fromOffset(40, 20), Position = UDim2.new(1, -50, 0.5, -10), BackgroundColor3 = THEME.off }, row)
	corner(sw, 10)
	local knob = new("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(3, 3), BackgroundColor3 = Color3.new(1, 1, 1) }, sw)
	corner(knob, 7)
	local btn = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, row)
	local state = false
	local function set(v, silent)
		state = v
		tw(sw, 0.25, { BackgroundColor3 = v and THEME.accent or THEME.off })
		tw(knob, 0.35, { Position = v and UDim2.fromOffset(23, 3) or UDim2.fromOffset(3, 3) }, Enum.EasingStyle.Back)
		if not silent then
			cb(v)
		end
	end
	btn.MouseButton1Click:Connect(function()
		set(not state)
	end)
	btn.MouseEnter:Connect(function()
		tw(row, 0.2, { BackgroundColor3 = THEME.rowHover })
	end)
	btn.MouseLeave:Connect(function()
		tw(row, 0.2, { BackgroundColor3 = THEME.row })
	end)
	return { set = set }
end

